# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION environment — Contabo VPS
# Copy this to .env.production and fill in every value.
# .env.production is in .gitignore and must NEVER be committed.
#
# DATABASE_URL is intentionally NOT set here — docker-compose.prod.yml
# constructs it automatically from POSTGRES_* vars so it always points
# to the Docker-internal postgres container. Setting it here would be
# overridden anyway.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=3000

# ── PostgreSQL (used by docker-compose.prod.yml to create the DB) ────────────
POSTGRES_DB=team_coach
POSTGRES_USER=team_coach
POSTGRES_PASSWORD=change_me_use_a_long_random_string

# ── Auto-migrate on container start (safe — idempotent) ──────────────────────
RUN_MIGRATIONS=true

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_use_64_random_chars
JWT_EXPIRES_IN=7d

# ── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_CALLBACK_URL=https://api.yourdomain.com/auth/google/callback

# ── CORS & public URLs ───────────────────────────────────────────────────────
# Set to your frontend domain(s) — comma-separated if multiple
CORS_ORIGIN=https://www.yourdomain.com
WEB_PUBLIC_URL=https://www.yourdomain.com

# ── Media storage ────────────────────────────────────────────────────────────
MEDIA_UPLOAD_DIR=uploads

# Cloudinary (optional — leave blank to use local disk storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=team-coach

# ── Gemini AI (stats extraction OCR) ─────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=Team Coach <noreply@yourdomain.com>

# ── Voice ────────────────────────────────────────────────────────────────────
VOICE_SELF_HOSTED=true
MEDIASOUP_ANNOUNCED_IP=YOUR_SERVER_PUBLIC_IP
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=40100

# LiveKit (if using hosted mode instead of self-hosted mediasoup)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Sacred Esports primary org ───────────────────────────────────────────────
PRIMARY_ORG_ID=

# ── pgAdmin (optional — only used if you start with --profile pgadmin) ───────
PGADMIN_EMAIL=admin@yourdomain.com
PGADMIN_PASSWORD=change_me
