generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  PLAYER
  COACH
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String? // null for accounts created via Google only
  googleId     String?  @unique
  name         String
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships Membership[]
}

model Org {
  id            String   @id @default(cuid())
  name          String
  orgCode       String   @unique // short code a player types in to join
  referralToken String   @unique // long token embedded in a shareable join link
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships Membership[]
}

model Membership {
  id        String         @id @default(cuid())
  role      MembershipRole
  userId    String
  orgId     String
  createdAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
}
