generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  PLAYER
  COACH
  ANALYST
}

enum GuildRole {
  MEMBER
  ELDER
  ACTIVE_LEADER
  LEADER
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String? // null for accounts created via Google only
  googleId      String?  @unique
  name          String
  avatarUrl     String?
  // Storage key for uploaded avatars — used to delete the previous file on replace.
  avatarFileKey String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Exactly one in-game role tag at a time, by design (see UpdateProfileDto
  // and the mobile/web profile screens, which all clamp to one). String[]
  // for forward compatibility, not because more than one is allowed today.
  roles String[] @default([])

  // Unique when set — incomplete profiles may leave these null (Postgres
  // allows multiple NULLs under a UNIQUE constraint).
  inGameName      String?   @unique
  inGameUid       String?   @unique
  phone           String?   @unique
  // Set only by Telegram verification (POST /users/me/phone/telegram → bot
  // contact share). Null = the number was never proven to belong to this user.
  phoneVerifiedAt DateTime?

  whatsappUrl  String?
  instagramUrl String?
  discordUrl   String?
  youtubeUrl   String?
  kickUrl      String?

  // What teammates see on GET /users/:id/profile. Phone stays off by default
  // (matches the old hard-hide); each social link stays on until the owner
  // flips it off. Own profile (/users/me) always returns the real values.
  showPhoneToMembers     Boolean @default(false)
  showWhatsappToMembers  Boolean @default(true)
  showInstagramToMembers Boolean @default(true)
  showDiscordToMembers   Boolean @default(true)
  showYoutubeToMembers   Boolean @default(true)
  showKickToMembers      Boolean @default(true)

  // Expo push token for the device currently signed in. One per user is enough
  // for Phase 1 testing; move to a per-device table if multi-device push matters later.
  expoPushToken String?

  // Platform-wide admin (not an org role). Grants read access to every org's
  // data through /admin. Deliberately a plain column with no API that can
  // write it: it is set only by `npm run admin:grant`, run on the server by
  // someone who already has database access. Nothing a client sends — a
  // request body, a profile field, or a JWT claim — can turn this on, and
  // JwtStrategy re-reads it from here on every single request rather than
  // trusting the token it was issued with.
  isPlatformAdmin Boolean @default(false)

  // Set by a platform admin to lock an account out. Checked in
  // JwtStrategy.validate on every single request, so a block takes effect on
  // the blocked user's next action rather than whenever their token happens
  // to expire. Nullable rather than a boolean so the list can show *when* —
  // "blocked" with no date is an argument waiting to happen.
  blockedAt     DateTime?
  blockedReason String?

  // Soft pause — set by the user from Account Settings. Login clears it
  // (reactivate). Distinct from blockedAt, which only an admin can lift.
  deactivatedAt DateTime?

  // Opt-in, admin-granted: 1-on-1 voice outside any org. Both people need
  // it before a call between them is possible (VoiceService.resolveRoom), so
  // granting it to one person alone exposes nothing. Set from /admin or
  // `npm run voice:direct:grant` — never from anything a client sends.
  canDirectVoice Boolean @default(false)

  // Bumped on logout; embedded in every JWT at sign time and checked against
  // this column on every authenticated request (JwtStrategy.validate) — the
  // only server-side way to invalidate outstanding tokens before they expire.
  tokenVersion Int @default(0)

  // Two-factor authentication (TOTP). twoFactorSecret is written at
  // /auth/2fa/setup but twoFactorEnabled only flips true once the user
  // proves they can generate a valid code at /auth/2fa/enable — never
  // enabled on the strength of setup alone. Backup codes are bcrypt-hashed,
  // one-time use (removed from the array on use).
  twoFactorSecret           String?
  twoFactorEnabled          Boolean  @default(false)
  twoFactorBackupCodeHashes String[] @default([])
  // Absolute 30s time-step of the last TOTP code accepted (setup/enable or
  // login) — rejects replaying the same or an older code within its validity
  // window. Null until the first code is ever accepted.
  lastTotpStep              Int?

  // False until the signup OTP is verified (/auth/verify-email) — true from
  // creation for Google accounts, since Google already requires a verified
  // email before AuthService.googleLogin will even create the user.
  emailVerified Boolean @default(false)

  // Optional second inbox for account recovery (password reset / lockout).
  // Must be verified via OTP before it is treated as usable.
  recoveryEmail           String?
  recoveryEmailVerifiedAt DateTime?

  // Last time this user had a live chat socket connection (ChatGateway).
  // Null until their first connect. Drives "last seen" in chat; "online"
  // itself is live-only (in-memory socket set), never persisted.
  lastSeenAt DateTime?

  emailVerificationCode EmailVerificationCode?
  recoveryEmailCode     RecoveryEmailCode?
  telegramPhoneLinks    TelegramPhoneLink[]
  passwordResetCode     PasswordResetCode?
  authSessions          AuthSession[]

  memberships        Membership[]
  guildMemberships   GuildMembership[]
  guildInvites       GuildMembership[]   @relation("GuildInvites")
  guildJoinRequests  GuildJoinRequest[]  @relation("GuildJoinRequests")
  guildJoinDecisions GuildJoinRequest[]  @relation("GuildJoinDecisions")
  devices            Device[]
  gameProfiles       UserGameProfile[]
  mediaPosts         MediaPost[]
  chatMessages       ChatMessage[]
  chatReadStates     ChatReadState[]
  chatDeliveryStates ChatDeliveryState[]
  chatMutes          ChatMute[]
  chatStars          ChatStar[]
  chatReactions      ChatReaction[]
  chatClears         ChatClear[]
  chatPins           ChatPin[]
  chatReminders      ChatReminder[]
  chatNicknamesGiven    ChatNickname[] @relation("ChatNicknamesGiven")
  chatNicknamesReceived ChatNickname[] @relation("ChatNicknamesReceived")
  scrimEvents        ScrimEvent[]
  statExtractions    StatExtraction[]
  playerStats        PlayerStat[]
  announcements      Announcement[]
  announcementReads  AnnouncementRead[]
  gameMatchResults   GameMatchPlayer[]
  healthGoal         HealthGoal?
  dailyHealthSamples DailyHealthSample[]
  routineItems       RoutineItem[]
  routineCompletions RoutineCompletion[]
}

// One outstanding signup-verification code per user — a resend overwrites
// this row rather than creating a new one. codeHash is bcrypt, same pattern
// as User.twoFactorBackupCodeHashes. attempts caps wrong-code guesses before
// the row is deleted and a fresh resend is required.
// One row per logged-out access token — lets logout revoke the ONE session
// that called it, not every device (tokenVersion on User is still bumped by
// changePassword, which should kill every other session; this is narrower).
// Rows are harmless to keep past expiresAt (the token itself would be
// rejected by JWT expiry anyway by then) — no cleanup job required, just an
// unbounded-but-slow-growing table in exchange for not needing a cron job.
model RevokedToken {
  jti       String   @id
  expiresAt DateTime

  @@index([expiresAt])
}

/// One row per minted access token. Lets Account Settings list active
/// sessions, mark trusted devices, and revoke a single login without
/// bumping tokenVersion (which would kill every device).
model AuthSession {
  id         String    @id @default(cuid())
  userId     String
  jti        String    @unique
  deviceName String?
  platform   String?
  userAgent  String?
  ip         String?
  trusted    Boolean   @default(false)
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

/// OTP gate for setting / changing User.recoveryEmail.
model RecoveryEmailCode {
  id        String   @id @default(cuid())
  userId    String   @unique
  email     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// One-time link from the app to the Telegram bot. The token travels in the
/// deep link (`t.me/<bot>?start=<token>`); the bot learns the chat id when the
/// user opens it, and the phone is only saved after the user shares their own
/// Telegram contact card.
model TelegramPhoneLink {
  token          String    @id
  userId         String
  telegramChatId BigInt?
  /// Number the user typed in the app; the bot only proceeds if the contact they share matches it.
  phone          String?
  /// SHA-256 of the 6-digit code the bot sent to the user's Telegram chat.
  codeHash       String?
  codeExpiresAt  DateTime?
  /// Wrong-code attempts; the link dies after a few so a 6-digit code can't be brute forced.
  attempts       Int       @default(0)
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([telegramChatId])
}

model EmailVerificationCode {
  id        String   @id @default(cuid())
  userId    String   @unique
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// One outstanding forgot-password code per user — same shape and lifecycle
// as EmailVerificationCode (bcrypt-hashed, TTL + attempts cap, a resend
// overwrites the row). Kept as its own table rather than reusing
// EmailVerificationCode so a password-reset code can never be replayed to
// satisfy the signup email-verification gate, or vice versa.
model PasswordResetCode {
  id        String   @id @default(cuid())
  userId    String   @unique
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Device {
  id        String   @id @default(cuid())
  userId    String
  name      String // e.g. "Main rig", "Travel laptop"
  model     String // e.g. "iPhone 15 Pro", "ROG Phone 8"
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Per-game IGN / UID / role. Free Fire stays the org identity for chat
/// mentions, stats OCR, and the post-login gate — writing FREE_FIRE also
/// mirrors onto User.inGameName / inGameUid / roles. Other games are optional.
model UserGameProfile {
  id         String   @id @default(cuid())
  userId     String
  /// FREE_FIRE | BGMI | MOBILE_LEGENDS | LOL
  game       String
  inGameName String?
  inGameUid  String?
  /// One role tag for this game (game-specific vocabulary).
  role       String?
  /// Peer visibility — own /users/me always returns the real values.
  showNameToMembers Boolean @default(true)
  showUidToMembers  Boolean @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, game])
  @@index([game, inGameUid])
  @@index([game, inGameName])
}

model Org {
  id                  String   @id @default(cuid())
  // Display name — also enforced case-insensitively in OrgService.createOrg.
  name                String   @unique
  // Guild community join (not the esports roster).
  orgCode             String   @unique
  referralToken       String   @unique
  // Esports roster join — separate from guild code/token so invites never collide.
  rosterCode          String   @unique
  rosterReferralToken String   @unique
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Free Fire in-game guild ID (digits). Optional — set at create or later
  // by the owner so teammates can find the guild inside Free Fire.
  freeFireGuildId String?

  // Owner-controlled: whether a member can see Team Chat messages from
  // before they joined. Chat history itself is always kept in full either
  // way — this only controls what's displayed to a given member. Defaults
  // on for a brand new org — an owner who wants it private can flip it off
  // in Org Settings.
  historyVisibleToNewMembers Boolean @default(true)

  memberships        Membership[]
  guildMemberships   GuildMembership[]
  mediaPosts         MediaPost[]
  chatMessages       ChatMessage[]
  chatReadStates     ChatReadState[]
  chatDeliveryStates ChatDeliveryState[]
  chatMutes          ChatMute[]
  chatChannelMetas   ChatChannelMeta[]
  chatPins           ChatPin[]
  chatStars          ChatStar[]
  chatClears         ChatClear[]
  chatReminders      ChatReminder[]
  chatNicknames      ChatNickname[]
  scrimEvents        ScrimEvent[]
  statExtractions    StatExtraction[]
  playerStats        PlayerStat[]
  mapImages          OrgMapImage[]
  customMaps         OrgCustomMap[]
  mapDropPoints      OrgMapDropPoint[]
  guildJoinRequests  GuildJoinRequest[]
  announcements      Announcement[]
  achievements       OrgAchievement[]
  gameMatches        GameMatch[]
}

// Guild trophy shelf — tournaments where the org reached grand finals.
// Everyone in the guild can read; only the org owner can add/remove.
model OrgAchievement {
  id             String   @id @default(cuid())
  orgId          String
  // Tournament / event name.
  name           String
  // Day of the grand final (or the finish date).
  playedAt       DateTime
  // Optional VOD / bracket / stream link.
  grandFinalLink String?
  // Placement text — "1st", "2nd", "Champion", etc.
  standing       String
  // Optional points-table screenshot (Cloudinary / local fileKey).
  pointsTableFileKey String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, playedAt])
}

// Org overrides for shared catalog images (Cloudinary / local fileKey).
model OrgMapImage {
  id        String   @id @default(cuid())
  orgId     String
  // Catalog map id, e.g. bermuda
  mapId     String
  // overview | primary | secondary | vending:machineId
  slot      String
  fileKey   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, mapId, slot])
  @@index([orgId, mapId])
}

// Fully custom map created by owner / coach / analyst.
model OrgCustomMap {
  id              String   @id @default(cuid())
  orgId           String
  name            String
  theme           String   @default("")
  size            String   @default("")
  overviewFileKey String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  org   Org               @relation(fields: [orgId], references: [id], onDelete: Cascade)
  drops OrgMapDropPoint[]

  @@index([orgId])
}

// Extra (or sole) drop points for a catalog map or a custom map.
model OrgMapDropPoint {
  id           String   @id @default(cuid())
  orgId        String
  catalogMapId String?
  customMapId  String?
  name         String
  // primary | secondary | extra
  tier         String   @default("extra")
  note         String   @default("")
  x            Float    @default(0.5)
  y            Float    @default(0.5)
  fileKey      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  org       Org           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customMap OrgCustomMap? @relation(fields: [customMapId], references: [id], onDelete: Cascade)

  @@index([orgId, catalogMapId])
  @@index([customMapId])
}

enum ScrimEventType {
  SCRIM
  TOURNAMENT
}

enum ScrimRoundResult {
  PENDING
  QUALIFIED
  ELIMINATED
}

model ScrimEvent {
  id          String         @id @default(cuid())
  orgId       String
  createdById String
  type        ScrimEventType
  title       String
  scheduledAt DateTime
  // Where it happens — a Discord link, a tournament platform URL, etc. Free text.
  platform    String?
  notes       String?
  // Team-wide push reminders before scheduledAt / each round start.
  remind30    Boolean        @default(true)
  remind10    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  org         Org              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy   User             @relation(fields: [createdById], references: [id], onDelete: Cascade)
  rounds      ScrimRound[]
  extractions StatExtraction[]
}

// Unlimited tournament (or scrim) rounds — Round 1 mirrors scheduledAt on create.
model ScrimRound {
  id          String           @id @default(cuid())
  eventId     String
  roundNumber Int
  scheduledAt DateTime
  result      ScrimRoundResult @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  event ScrimEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, roundNumber])
  @@index([eventId])
}

// channelKey: "org" for team group chat, or "dm:{sortedUserIdA}:{sortedUserIdB}" for 1:1.
model ChatMessage {
  id         String        @id @default(cuid())
  orgId      String
  channelKey String        @default("org")
  senderId   String
  text       String?
  mediaUrl   String?
  mediaType  MediaType?
  createdAt  DateTime      @default(now())
  editedAt   DateTime?
  // Soft "delete for everyone" — row stays so replies don't break; clients
  // render "This message has been deleted" when set.
  deletedAt  DateTime?
  // WhatsApp-style reply — null for top-level messages.
  replyToId  String?
  replyTo    ChatMessage?  @relation("ChatReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies    ChatMessage[] @relation("ChatReplies")
  // True when this message was created via POST /chat/forward — client
  // renders a "Forwarded" label. We deliberately don't track which message
  // it came from (WhatsApp doesn't show that either, and it would leak
  // whether the forwarder has access to the source channel).
  forwarded  Boolean       @default(false)

  org       Org            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sender    User           @relation(fields: [senderId], references: [id], onDelete: Cascade)
  pins      ChatPin[]
  stars     ChatStar[]
  reactions ChatReaction[]

  @@index([orgId, channelKey, createdAt])
  @@index([replyToId])
}

// Personal alias for another org member — only the viewer sees it (DM title,
// sender labels). Others keep the real name.
model ChatNickname {
  id           String   @id @default(cuid())
  userId       String
  orgId        String
  targetUserId String
  nickname     String   @db.VarChar(32)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user   User @relation("ChatNicknamesGiven", fields: [userId], references: [id], onDelete: Cascade)
  target User @relation("ChatNicknamesReceived", fields: [targetUserId], references: [id], onDelete: Cascade)
  org    Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId, targetUserId])
  @@index([userId, orgId])
}

// Per-user mute for a channel — muted channels skip push notifications.
model ChatMute {
  id         String   @id @default(cuid())
  userId     String
  orgId      String
  channelKey String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId, channelKey])
  @@index([userId, orgId])
}

// Shared pin for a channel (WhatsApp-style, max few per room).
model ChatPin {
  id         String   @id @default(cuid())
  orgId      String
  channelKey String
  messageId  String
  pinnedById String
  pinnedAt   DateTime @default(now())

  org      Org         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  message  ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  pinnedBy User        @relation(fields: [pinnedById], references: [id], onDelete: Cascade)

  @@unique([orgId, channelKey, messageId])
  @@index([orgId, channelKey])
}

// Per-user starred / favourite messages.
model ChatStar {
  id         String   @id @default(cuid())
  userId     String
  orgId      String
  channelKey String
  messageId  String
  createdAt  DateTime @default(now())

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  org     Org         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId])
  @@index([userId, orgId, channelKey])
}

// One reaction per user per message (tapping a different emoji replaces it,
// tapping the same one again removes it — same gesture WhatsApp uses).
model ChatReaction {
  id        String   @id @default(cuid())
  userId    String
  messageId String
  emoji     String   @db.VarChar(16)
  createdAt DateTime @default(now())

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId])
  @@index([messageId])
}

// Per-user personal reminder for a chat — push only to the creator at fireAt.
model ChatReminder {
  id         String    @id @default(cuid())
  userId     String
  orgId      String
  channelKey String
  message    String    @db.VarChar(40)
  fireAt     DateTime
  sentAt     DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([sentAt, fireAt])
  @@index([userId, orgId, channelKey])
}

// Soft "clear chat for me" — hide messages at/before clearedAt for this user.
model ChatClear {
  id         String   @id @default(cuid())
  userId     String
  orgId      String
  channelKey String
  clearedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId, channelKey])
}

// Channel-level settings: description, group avatar, disappearing timer.
model ChatChannelMeta {
  id                String   @id @default(cuid())
  orgId             String
  channelKey        String
  description       String?  @db.VarChar(500)
  avatarUrl         String?
  avatarFileKey     String?
  // null = off; otherwise auto-delete messages older than this many seconds.
  disappearAfterSec Int?
  updatedAt         DateTime @updatedAt
  updatedById       String?

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, channelKey])
}

model ChatReadState {
  id         String   @id @default(cuid())
  userId     String
  orgId      String
  channelKey String
  lastReadAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId, channelKey])
}

model ChatDeliveryState {
  id              String   @id @default(cuid())
  userId          String
  orgId           String
  channelKey      String
  lastDeliveredAt DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId, channelKey])
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
}

model MediaPost {
  id         String    @id @default(cuid())
  orgId      String
  uploaderId String
  type       MediaType
  // Filename under the uploads directory, randomly generated — not the original
  // filename. Served as a static file; see backend/src/media for the access-control note.
  fileKey    String    @unique
  caption    String?
  createdAt  DateTime  @default(now())

  org      Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  uploader User @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  statExtraction StatExtraction?
}

enum StatExtractionStatus {
  QUEUED // just created — OCR hasn't run yet (StatsExtractionWorkerService picks it up)
  PROCESSING // a worker tick has claimed it and is calling Gemini right now
  PENDING // OCR finished, rows are populated, awaiting coach/owner review
  CONFIRMED
  REJECTED
  FAILED // OCR errored — see failureReason; can be retried back to QUEUED
}

// Grind / match category for OCR scoreboards — history & leaderboards are per mode.
enum StatMode {
  BR
  CS
  SCRIM
  TOURNAMENT
}

// AI-suggested per-player stats read from a MediaPost screenshot. Nothing in
// `rows` is trusted until a human confirms it — see backend/src/stats.
model StatExtraction {
  id            String               @id @default(cuid())
  orgId         String
  mediaPostId   String               @unique
  requestedById String
  mode          StatMode             @default(BR)
  // Set when uploaded against a specific Scrim / Tournament calendar event.
  scrimEventId  String?
  status        StatExtractionStatus @default(QUEUED)
  // Set only when status is FAILED — the OCR error message, shown to the user.
  failureReason String?
  // Array of { rawName, matchedUserId, kills, deaths, assists, damage }, empty
  // until OCR runs, editable while PENDING.
  rows          Json
  createdAt     DateTime             @default(now())
  reviewedAt    DateTime?

  org         Org         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  mediaPost   MediaPost   @relation(fields: [mediaPostId], references: [id], onDelete: Cascade)
  requestedBy User        @relation(fields: [requestedById], references: [id], onDelete: Cascade)
  scrimEvent  ScrimEvent? @relation(fields: [scrimEventId], references: [id], onDelete: SetNull)

  playerStats PlayerStat[]

  @@index([orgId, mode, status])
  @@index([scrimEventId])
}

// One confirmed row of stats for one player, created only once a human
// confirms a StatExtraction.
model PlayerStat {
  id           String   @id @default(cuid())
  userId       String
  orgId        String
  mode         StatMode @default(BR)
  kills        Int
  deaths       Int
  assists      Int
  damage       Int      @default(0)
  recordedAt   DateTime @default(now())
  extractionId String
  createdAt    DateTime @default(now())

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  org        Org            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  extraction StatExtraction @relation(fields: [extractionId], references: [id], onDelete: Cascade)

  @@index([orgId, mode])
  @@index([userId, mode])
}

model Membership {
  id        String          @id @default(cuid())
  // Null for an owner who has not chosen a roster seat. Owner is a flag,
  // not a coach/player/analyst seat, until they pick one from their profile.
  role      MembershipRole?
  userId    String
  orgId     String
  createdAt DateTime        @default(now())

  // Exactly one membership per org should have this set — the org creator,
  // by default, transferable via OrgService.transferOwnership. Orthogonal to
  // `role`: the owner may also hold a functional role (COACH/ANALYST/PLAYER),
  // but that choice is optional. Enforced in application code (OrgService).
  isOwner Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // A user has one roster seat, period — not just one per org. Enforced here
  // at the DB level (not just the application's check-then-act
  // assertUserHasNoOrg) so two concurrent join/create requests can't race
  // past the "only one org" rule the application layer intends.
  @@unique([userId])
}

// Community seat inside an org. Separate from Membership, which is the
// esports roster (chat, records, scrims). Joining with a guild code creates
// only this row.
enum GuildJoinRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  // Auto-withdrawn because the user was accepted somewhere else. Keeps the
  // row (so the requester can see what happened) while dropping it out of
  // every other owner's inbox.
  SUPERSEDED
}

// Joining a guild from the public browse list is a request the owner has to
// accept. Joining with the org code or a personal invite link stays direct —
// having the code is itself the owner's permission.
model GuildJoinRequest {
  id          String                 @id @default(cuid())
  userId      String
  orgId       String
  status      GuildJoinRequestStatus @default(PENDING)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  decidedAt   DateTime?
  decidedById String?

  user      User  @relation("GuildJoinRequests", fields: [userId], references: [id], onDelete: Cascade)
  org       Org   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  decidedBy User? @relation("GuildJoinDecisions", fields: [decidedById], references: [id], onDelete: SetNull)

  // Asking the same guild again reuses the row rather than stacking rows in
  // the owner's inbox.
  @@unique([userId, orgId])
  @@index([orgId, status])
  @@index([userId, status])
}

model GuildMembership {
  id              String    @id @default(cuid())
  role            GuildRole @default(MEMBER)
  userId          String
  orgId           String
  // Who shared the invite/code that brought this member in (null = unknown /
  // legacy / org-owner bootstrap). Used for per-user referral totals.
  invitedByUserId String?
  createdAt       DateTime  @default(now())

  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  org       Org   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invitedBy User? @relation("GuildInvites", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  // One guild seat per user, same reasoning as Membership above.
  @@unique([userId])
  @@index([orgId])
  @@index([invitedByUserId])
}

// Public marketing-site tournament ledger (sacredesports.com Records tab).
// Readable by anyone; writable only by org coaches / owners.
model WebsiteTournamentRecord {
  id            String   @id @default(cuid())
  name          String
  status        String
  kind          String
  progress      String?
  qualifierDate String?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([sortOrder])
}

// Owner-to-everyone broadcast inside one org: it pushes to every member's
// phone AND is kept here, so somebody whose phone was off (or who installed
// the app later) still finds it in the Announcements section. A push alone
// would be write-only — delivered or lost, with nothing to come back to.
model Announcement {
  id        String   @id @default(cuid())
  orgId     String
  // Null once the author's account is gone — the announcement itself is
  // org history and outlives whoever happened to post it.
  authorId  String?
  title     String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org    Org                @relation(fields: [orgId], references: [id], onDelete: Cascade)
  author User?              @relation(fields: [authorId], references: [id], onDelete: SetNull)
  reads  AnnouncementRead[]

  // The only query this table serves: one org's announcements, newest first.
  @@index([orgId, createdAt])
}

// Who has seen which announcement. A row exists only once someone has read
// it, so "unread" is the absence of a row — no backfill needed when a new
// member joins, and no row to write for people who never open the section.
model AnnouncementRead {
  id             String   @id @default(cuid())
  announcementId String
  userId         String
  readAt         DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId])
}

// The seven in-app mini-games (GamesService / GamesGateway, Socket.IO
// /games namespace) — see backend/src/games. `playedAt` is when the match
// actually ended, not when the row was written, so a backfill or retry never
// shifts a match's place on the leaderboard.
enum MiniGameKind {
  RPS
  LUDO
  BOOTS
  CUT
  CHESS
  UNO
  RACE
}

// One finished mini-game match. Written once, from GamesService.finish(),
// for every game that reaches 'done' — including a forfeit, so leaving a
// losing game still counts as a loss rather than quietly vanishing from
// history. `players` is the roster GamesService captured when the match
// *started* (startGame), not whoever is still in the room at the end — a
// player who forfeits is spliced out of the live room immediately, and
// would otherwise disappear from their own loss.
model GameMatch {
  id        String       @id @default(cuid())
  orgId     String
  game      MiniGameKind
  // Null for a draw/stalemate — not every game can end without a winner
  // (Chess, Cut), but the ones that can (Boots forfeit-to-nobody, Rps draw
  // ending in a forfeit with one player) need this nullable.
  winnerId  String?
  // Free text from the engine's own end-reason union (e.g. Chess's
  // 'checkmate' | 'stalemate' | 'forfeit', Cut's 'done', Race's
  // 'finish' | 'forfeit') — never matched on in a query, only shown.
  endReason String?
  playedAt  DateTime     @default(now())

  org     Org               @relation(fields: [orgId], references: [id], onDelete: Cascade)
  players GameMatchPlayer[]

  @@index([orgId, game, playedAt])
  @@index([orgId, playedAt])
}

// One player's result in one match. `game` is denormalised off GameMatch
// (not just reachable via the relation) so the leaderboard's per-game
// breakdown is a single `groupBy` on this table alone, no join required.
model GameMatchPlayer {
  id      String       @id @default(cuid())
  matchId String
  userId  String
  orgId   String
  game    MiniGameKind
  won     Boolean      @default(false)

  match GameMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
  @@index([orgId, userId])
  @@index([orgId, game, userId])
  @@index([orgId, userId, won])
}

// Personal habit tracker — steps / heart-points goals (one row per user).
model HealthGoal {
  userId    String   @id
  stepGoal  Int      @default(10000)
  heartGoal Int      @default(30)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// One synced health sample per local calendar day.
model DailyHealthSample {
  id          String   @id @default(cuid())
  userId      String
  /// Local calendar day "YYYY-MM-DD" (device timezone).
  day         String
  steps       Int
  heartPoints Int      @default(0)
  source      String?
  syncedAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([userId, day])
}

// Recurring daily timed habit (alarm time is local HH:mm).
model RoutineItem {
  id           String   @id @default(cuid())
  userId       String
  title        String
  /// Local wall-clock time "HH:mm" (24h).
  timeLocal    String
  alarmEnabled Boolean  @default(true)
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  completions RoutineCompletion[]

  @@index([userId, active])
}

model RoutineCompletion {
  id            String   @id @default(cuid())
  routineItemId String
  userId        String
  /// Local calendar day "YYYY-MM-DD".
  day           String
  completedAt   DateTime @default(now())

  routineItem RoutineItem @relation(fields: [routineItemId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([routineItemId, day])
  @@index([userId, day])
}
