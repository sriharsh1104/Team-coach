# Used only by automated tests (npm run test:e2e) — a separate database so
# tests never touch the data you've been manually testing with.
NODE_ENV=test
PORT=3001

DATABASE_URL="postgresql://team_coach:team_coach_local_pw@localhost:5432/team_coach_test?schema=public"

JWT_SECRET="test-only-secret-not-for-real-use-00000000000000000000000000000000"
JWT_EXPIRES_IN="1h"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3001/auth/google/callback"

CORS_ORIGIN="*"

MEDIA_UPLOAD_DIR="uploads_test"

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

VOICE_SELF_HOSTED=true
MEDIASOUP_ANNOUNCED_IP="127.0.0.1"
MEDIASOUP_MIN_PORT="41000"
MEDIASOUP_MAX_PORT="41100"
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
