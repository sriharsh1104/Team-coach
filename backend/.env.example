# Copy this to .env.development / .env.stage / .env.production and fill in real values.
# This file itself has no secrets and is safe to commit.

NODE_ENV=development
PORT=3000

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/team_coach?schema=public"

JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# From https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"

CORS_ORIGIN="*"

# Where uploaded screenshots/clips are stored, relative to backend/
MEDIA_UPLOAD_DIR="uploads"

# Get a key at https://console.anthropic.com/settings/keys — used to read
# player stats out of uploaded scrim/tournament screenshots (Phase 1F).
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"

# From https://resend.com/api-keys — RESEND_FROM_EMAIL must be an address on
# a domain verified in Resend. Used for signup email-verification codes and
# emailing an auto-generated password to new Google-login accounts.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Team Coach <noreply@yourdomain.com>"

VOICE_SELF_HOSTED=true
MEDIASOUP_ANNOUNCED_IP="127.0.0.1"
MEDIASOUP_MIN_PORT="40000"
MEDIASOUP_MAX_PORT="40100"
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
