# Copy this to .env.development / .env.stage / .env.production and fill in real values.
# This file itself has no secrets and is safe to commit.

NODE_ENV=development
PORT=3000

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/team_coach?schema=public"

JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# From https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"

CORS_ORIGIN="*"

# Where uploaded screenshots/clips are stored locally when Cloudinary is off
MEDIA_UPLOAD_DIR="uploads"

# Cloudinary (image + video CDN). Free account: https://cloudinary.com/users/register/free
# Dashboard → Settings → API Keys. Leave blank to keep local disk storage.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="team-coach"

# Google AI Studio key — Gemini Flash OCR for scoreboard screenshots
# (name + K/D/A → match teammates → leaderboard). Get a key at:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# From https://resend.com/api-keys — RESEND_FROM_EMAIL must be an address on
# a domain verified in Resend. Used for signup email-verification codes and
# emailing an auto-generated password to new Google-login accounts.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Team Coach <noreply@yourdomain.com>"

VOICE_SELF_HOSTED=true
MEDIASOUP_ANNOUNCED_IP="127.0.0.1"
MEDIASOUP_MIN_PORT="40000"
MEDIASOUP_MAX_PORT="40100"
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
