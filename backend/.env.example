# Copy this to .env.development / .env.stage / .env.production and fill in real values.
# This file itself has no secrets and is safe to commit.

NODE_ENV=development
PORT=3000

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/team_coach?schema=public"

JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# From https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"

CORS_ORIGIN="*"
