<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- Keeps the CPU running so recording does not pause in background -->
  <uses-permission android:name="android.permission.WAKE_LOCK" />

  <application>
    <activity
      android:name=".CapturePermissionActivity"
      android:excludeFromRecents="true"
      android:exported="false"
      android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    <!--
      stopWithTask=false  → service survives if user removes app from Recents
      foregroundServiceType → required by Android 10+ for media projection
    -->
    <service
      android:name=".ScreenRecordService"
      android:exported="false"
      android:foregroundServiceType="mediaProjection"
      android:stopWithTask="false" />
  </application>
</manifest>
