{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "APP_ENV=development expo start",
    "start:stage": "APP_ENV=stage expo start",
    "start:prod": "APP_ENV=production expo start",
    "android": "APP_ENV=development expo start --android",
    "ios": "APP_ENV=development expo start --ios",
    "web": "APP_ENV=development WEB_API_BASE_URL=http://localhost:3000 expo start --web --port 8090",
    "build:apk": "cd android && ./gradlew assembleDebug",
    "build:apk:release": "cd android && ./gradlew assembleRelease",
    "sha1": "cd android && ./gradlew signingReport",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "lint": "npx expo lint",
    "prebuild:check": "npm run typecheck && npm run test -- --passWithNoTests && node node_modules/expo-doctor/build/index.js"
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "10.0.0",
    "@expo/metro-runtime": "~4.0.1",
    "@expo/vector-icons": "~14.0.4",
    "@livekit/react-native": "^3.1.0",
    "@livekit/react-native-webrtc": "^150.1.0",
    "@react-native-community/datetimepicker": "8.2.0",
    "@react-native-google-signin/google-signin": "^17.0.0",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "axios": "^1.7.9",
    "expo": "~52.0.11",
    "expo-application": "~6.0.2",
    "expo-asset": "~11.0.1",
    "expo-auth-session": "~6.0.0",
    "expo-av": "~15.0.2",
    "expo-clipboard": "~7.0.0",
    "expo-constants": "~17.0.3",
    "expo-crypto": "~14.0.2",
    "expo-dev-client": "~5.0.20",
    "expo-font": "~13.0.4",
    "expo-image": "~2.0.7",
    "expo-image-manipulator": "~13.0.6",
    "expo-image-picker": "~16.0.6",
    "expo-local-authentication": "~15.0.2",
    "expo-media-library": "~17.0.6",
    "expo-notifications": "~0.29.14",
    "expo-secure-store": "~14.0.1",
    "expo-status-bar": "~2.0.0",
    "expo-system-ui": "~4.0.9",
    "expo-web-browser": "~14.0.1",
    "libphonenumber-js": "^1.13.15",
    "livekit-client": "^2.23.0",
    "mediasoup-client": "^3.18.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-compressor": "1.11.0",
    "react-native-qrcode-svg": "^6.3.54",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-web": "~0.19.13",
    "rn-international-phone-number": "^0.15.1",
    "screen-recorder": "file:modules/screen-recorder",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@livekit/react-native-expo-plugin": "^1.1.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~18.3.12",
    "dotenv": "^16.4.7",
    "expo-doctor": "^1.11.3",
    "jest": "~29.7.0",
    "jest-expo": "~52.0.6",
    "react-test-renderer": "^18.3.1",
    "typescript": "~5.3.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ]
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@expo/metro-runtime",
          "expo-av",
          "@config-plugins/react-native-webrtc",
          "libphonenumber-js",
          "screen-recorder",
          "socket.io-client"
        ]
      }
    }
  }
}
