    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-phone-number-input": "^3.4.18",
    "react-router-dom": "^7.18.5",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~7.0.2",
    "vite": "^5.4.11"
