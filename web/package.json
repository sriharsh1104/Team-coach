  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode development",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy:cloudflare": "npm run build && wrangler pages deploy dist --project-name=sacred-esports",

    "tauri": "tauri",
