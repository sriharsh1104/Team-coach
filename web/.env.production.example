# Used when you run: npm run build
# Marketing site can leave API blank / localhost until backend is hosted.
VITE_API_BASE_URL=https://api.sacredesports.com
VITE_APK_URL=/downloads/sacred-esports.apk
VITE_GOOGLE_CLIENT_ID=

# Desktop app installers (Tauri) — OPTIONAL overrides. By default the home page
# links to the latest GitHub Release (stable names, see DESKTOP.md):
#   https://github.com/sriharsh1104/Team-coach/releases/latest/download/sacred-esports-linux-x64.deb
#   https://github.com/sriharsh1104/Team-coach/releases/latest/download/sacred-esports-windows-x64-setup.exe
# Set these only if you host the installers somewhere else.
VITE_DESKTOP_LINUX_URL=
VITE_DESKTOP_WINDOWS_URL=
